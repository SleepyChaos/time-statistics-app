{
  "name": "time-statistics-app",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "description": "A local-first time tracking app inspired by Lyubishchev's time accounting method.",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/react-query": "^5.101.4",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.8",
    "expo-crypto": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-notifications": "~57.0.8",
    "expo-router": "~57.0.9",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "~29.5.14",
    "@types/react": "~19.2.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "~9.39.2",
    "eslint-config-expo": "^57.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.3",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "ios": "expo run:ios",
    "skia:install-libs": "node ./node_modules/@shopify/react-native-skia/scripts/install-libs.js",
    "prebuild:ios": "pnpm skia:install-libs && expo prebuild --platform ios",
    "web": "expo start --web",
    "bundle:ios": "expo export --platform ios --output-dir .build-check",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --runInBand",
    "check": "pnpm lint && pnpm typecheck && pnpm test:ci"
  },
  "private": false
}
